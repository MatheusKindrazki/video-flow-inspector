{
  "name": "video-flow-inspector",
  "version": "0.1.0",
  "description": "MCP server for video-based UI flow analysis and debugging",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "video-flow-inspector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
