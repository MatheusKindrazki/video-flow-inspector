# Export via your shell or MCP client's env. .env is NOT loaded automatically.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_PROVIDER=gemini
FALLBACK_PROVIDER=openai
# Verify model availability on your own account.
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_MODEL=gpt-4o
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_SIZE_MB=150
MAX_KEYFRAMES=20
KEYFRAME_INTERVAL_SECONDS=2
FRAME_CHANGE_THRESHOLD=0.15
FRAME_SAFETY_INTERVAL_MS=3000
SEGMENT_SECONDS=60
SEGMENT_OVERLAP_SECONDS=2
SEGMENT_CONCURRENCY=2
MAX_REFINEMENTS=2
MAX_PROVIDER_CALLS=32
ANALYSIS_DEADLINE_MS=900000
GEMINI_ESCALATION_ENABLED=false
GEMINI_ESCALATION_MODEL=gemini-3.5-flash
GEMINI_ESCALATION_CONFIDENCE_THRESHOLD=0.5
GEMINI_ESCALATION_ON_CRITICAL=true
GEMINI_TIMEOUT_REDUCE_FRAMES=true
MAX_OUTPUT_TOKENS=8192
# ANALYSIS_JOBS_DIR=/private/per-server/report-directory
LOG_LEVEL=info
