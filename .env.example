# Primary provider (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: anthropic for future use
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Analysis settings
DEFAULT_PROVIDER=gemini
FALLBACK_PROVIDER=openai
MAX_KEYFRAMES=20
KEYFRAME_INTERVAL_SECONDS=2
MAX_VIDEO_SIZE_MB=150
MAX_VIDEO_DURATION_SECONDS=300
FRAME_CHANGE_THRESHOLD=0.15
FRAME_SAFETY_INTERVAL_MS=3000

# Gemini cost controls
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ESCALATION_ENABLED=false
GEMINI_ESCALATION_MODEL=gemini-3.5-flash
GEMINI_ESCALATION_CONFIDENCE_THRESHOLD=0.5
GEMINI_ESCALATION_ON_CRITICAL=true
GEMINI_TIMEOUT_REDUCE_FRAMES=true
MAX_OUTPUT_TOKENS=8192

# Logging
LOG_LEVEL=info
